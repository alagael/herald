{
  "name": "@alagael/herald",
  "version": "0.1.0",
  "description": "Encrypted letters requiring both a future drand beacon and a threshold of Keeper shares to open.",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "author": "Alagael contributors",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.17.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/alagael/herald.git"
  },
  "bugs": {
    "url": "https://github.com/alagael/herald/issues"
  },
  "homepage": "https://github.com/alagael/herald#readme",
  "files": [
    "dist",
    "src",
    "vendor",
    "abi",
    "deployments",
    "examples",
    "assets",
    "build.mjs",
    "scripts",
    "test",
    "lib",
    "foundry.toml",
    "pnpm-lock.yaml",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "RELEASING.md",
    "CODE_OF_CONDUCT.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node build.mjs test",
    "prepack": "pnpm run build"
  },
  "keywords": [
    "alagael",
    "ethereum",
    "privacy",
    "inheritance"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
